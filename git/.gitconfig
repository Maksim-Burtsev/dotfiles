[user]
	name = Maksim Burtsev
	email = zadrot-lol@list.ru

# Пуш по HTTPS берёт токен из gh, поэтому на новой машине хватает `gh auth login`.
[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[include]
	path = ~/.gitconfig.local

# Private url.insteadOf entries from the local ~/.gitconfig are intentionally not tracked.
