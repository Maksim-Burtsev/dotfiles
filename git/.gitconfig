[user]
	name = Maksim Burtsev
	email = zadrot-lol@list.ru

# Пуш по HTTPS берёт токен из gh, поэтому на новой машине хватает `gh auth login`.
# Пустой helper обнуляет цепочку, унаследованную из системного gitconfig: иначе
# первым опрашивается osxkeychain, просит пароль от связки ключей и до gh дело
# не доходит. Сброс действует только на github.com, у остальных хостов
# osxkeychain продолжает работать.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	light = true
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = vscode://file/{path}:{line}
	syntax-theme = Coldark-Cold
	file-style = bold blue
	file-decoration-style = blue ul
	hunk-header-decoration-style = blue box
	hunk-header-style = file line-number syntax
	minus-style = normal "#ffebe9"
	minus-emph-style = normal "#ffc1c0"
	plus-style = syntax "#e6ffec"
	plus-emph-style = syntax "#abf2bc"
	max-line-length = 0

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	conflictstyle = zdiff3

[alias]
	review = "!f(){ git diff \"${2:-origin/master}...${1:-HEAD}\"; };f"
	reviewt = "!f(){ GIT_EXTERNAL_DIFF=difft git --no-pager diff \"${2:-origin/master}...${1:-HEAD}\"; };f"
	reviewls = "!f(){ git diff --stat \"${2:-origin/master}...${1:-HEAD}\"; };f"

# Last, so machine-specific values win over everything tracked above
# (private url.insteadOf entries; delta's hyperlink format on the remote box).
[include]
	path = ~/.gitconfig.local
