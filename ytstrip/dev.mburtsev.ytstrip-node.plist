<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.mburtsev.ytstrip-node</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/tailscale/bin/tailscaled</string>
    <string>--tun=userspace-networking</string>
    <string>--statedir=/Users/mburtsev/.local/share/ytstrip/ts</string>
    <string>--socket=/Users/mburtsev/.local/share/ytstrip/ts.sock</string>
    <string>--port=41642</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/mburtsev/Library/Logs/ytstrip/node.log</string>
  <key>StandardErrorPath</key><string>/Users/mburtsev/Library/Logs/ytstrip/node.log</string>
</dict>
</plist>
