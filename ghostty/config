# Шрифт — как в iTerm: Monaco 15, bold есть, italic нет, лигатур нет
font-family = Monaco
font-size = 15

# Theme. Browse others: ghostty +list-themes (interactive preview).
theme = TokyoNight Moon

# Окно и вид — как в iTerm
background-opacity = 0.947
window-width = 91
window-height = 30
cursor-style = bar
cursor-style-blink = false
macos-option-as-alt = false

# Улучшения против iTerm (там было 1000 строк скроллбэка)
scrollback-limit = 52428800
mouse-hide-while-typing = true

# Панель, где агент дёрнул bell, помечается — видно, кто закончил
bell-features = system, attention, title

# Не даёт случайно убить Cmd+Q/Cmd+W окно с 8 живыми агентами
confirm-close-surface = true

# Хоткеи сверх дефолтов
keybind = cmd+shift+e=equalize_splits
keybind = cmd+enter=toggle_fullscreen

# Между сплитами на Ctrl+Opt+стрелки (дефолтные Cmd+Opt+стрелки тоже работают)
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
