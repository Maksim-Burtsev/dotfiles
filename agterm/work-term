#!/usr/bin/env bash
# Open the work laptop's projects in agterm: one workspace per project, with one ssh session in it.
# Each session runs on the laptop (under its VPN), so claude / vim / git inside it run there.
#   work-term        open every project
#   work-term here   one more session in the current workspace's project (bound in keymap.conf)
# Needs in ~/.zshrc.local (untracked):
#   export WORK_PROJECTS="~/Work/a ~/Work/b"   # remote paths, space-separated
# and a `Host work` block in ~/.ssh/config (key auth, no prompts: agterm runs ssh non-interactively).
# ponytail: the remote zsh emits no OSC 7, so agterm's $AGT_SESSION_PWD is the local home;
# the project path is looked up by workspace name instead.
set -euo pipefail
source "$HOME/.zshrc.local"
[ -n "${WORK_PROJECTS:-}" ] || { echo "work-term: set WORK_PROJECTS in ~/.zshrc.local" >&2; exit 1; }

open_session() {  # $1 = remote path
  agtermctl session new --workspace-name "${1##*/}" --create-workspace --name "${1##*/}" --no-select \
    --command "ssh -t work 'cd $1 && exec zsh -l'" >/dev/null
}

if [ "${1:-}" = here ]; then
  for p in $WORK_PROJECTS; do
    [ "${p##*/}" = "${AGT_WORKSPACE_NAME:-}" ] && { open_session "$p"; exit 0; }
  done
  echo "work-term: workspace '${AGT_WORKSPACE_NAME:-}' is not in WORK_PROJECTS" >&2; exit 1
fi

ssh -o BatchMode=yes -o ConnectTimeout=5 work true || { echo "work-term: laptop unreachable (asleep / other network?)" >&2; exit 1; }
for p in $WORK_PROJECTS; do open_session "$p"; done
