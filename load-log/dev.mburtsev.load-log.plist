<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.mburtsev.load-log</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>mkdir -p "$HOME/.local/state" &amp;&amp; echo "$(date +%FT%T) $(sysctl -n vm.loadavg)" &gt;&gt; "$HOME/.local/state/load.log"</string></array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
