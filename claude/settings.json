{
  "agentPushNotifEnabled": false,
  "cleanupPeriodDays": 365,
  "enableArtifact": true,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "mattpocock-skills@mattpocock": true,
    "ponytail@ponytail": true,
    "productivity@synced": false,
    "punchcard@punchcard": true
  },
  "env": {
    "CLAUDE_CODE_NATIVE_CURSOR": "1"
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "repo": "mattpocock/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "punchcard": {
      "source": {
        "source": "git",
        "url": "https://github.com/Maksim-Burtsev/punchcard.git"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/open-source/dotfiles/claude/hooks/dotfiles-guard.sh post",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "f=\"$HOME/open-source/second-brain/system/context.py\"; [ -f \"$f\" ] && /usr/bin/python3 \"$f\"; exit 0",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "f=\"$HOME/open-source/second-brain/system/context.py\"; [ -f \"$f\" ] && /usr/bin/python3 \"$f\" --compass personal; exit 0",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "$HOME/open-source/dotfiles/claude/hooks/bridge-local-note.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"$HOME/open-source/dotfiles/claude/hooks/session-title.py\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "allow": [
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__search_threads",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__get_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__list_labels",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__create_label",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__label_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__unlabel_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__label_message",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__unlabel_message",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__update_message_labels",
      "mcp__claude-code-remote__set_session_title",
      "Artifact",
      "PushNotification",
      "Read",
      "Write",
      "Edit",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(cp:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(python3:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue edit:*)"
    ],
    "deny": [
      "ReportFindings",
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__confirm_repository_trust",
      "mcp__claude-code-remote__create_environment",
      "mcp__claude-code-remote__create_trigger",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__claude-code-remote__fire_trigger",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__get_trigger",
      "mcp__claude-code-remote__list_computer_folders",
      "mcp__claude-code-remote__list_repos",
      "mcp__claude-code-remote__list_triggers",
      "mcp__claude-code-remote__register_repo_root",
      "mcp__claude-code-remote__report_preview_port",
      "mcp__claude-code-remote__request_computer_folder",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__switch_environment",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__unwatch_url",
      "mcp__claude-code-remote__update_environment",
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__watch_url"
    ]
  },
  "remoteControlAtStartup": true,
  "skillOverrides": {
    "anthropic-skills:deep-research": "name-only",
    "anthropic-skills:docx": "name-only",
    "anthropic-skills:google-workspace": "name-only",
    "anthropic-skills:import-memory": "name-only",
    "anthropic-skills:morning": "name-only",
    "anthropic-skills:pdf": "name-only",
    "anthropic-skills:pptx": "name-only",
    "anthropic-skills:skill-creator": "name-only",
    "anthropic-skills:xlsx": "name-only",
    "code-review": "name-only",
    "fewer-permission-prompts": "name-only",
    "init": "name-only",
    "keybindings-help": "name-only",
    "loop": "name-only",
    "plugin-authoring": "name-only",
    "run": "name-only",
    "schedule": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "workflow-authoring": "name-only"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "subagentPromptCacheTtl": "1h",
  "theme": "auto",
  "tui": "fullscreen"
}
