{
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 365,
  "enabledPlugins": {
    "diagram-design@diagram-design": true,
    "mattpocock-skills@mattpocock": true,
    "ponytail@ponytail": true,
    "punchcard@punchcard": true,
    "superpowers@superpowers-dev": true
  },
  "env": {
    "CLAUDE_CODE_NATIVE_CURSOR": "1"
  },
  "extraKnownMarketplaces": {
    "diagram-design": {
      "source": {
        "repo": "cathrynlavery/diagram-design",
        "source": "github"
      }
    },
    "mattpocock": {
      "source": {
        "repo": "mattpocock/skills",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "punchcard": {
      "source": {
        "source": "git",
        "url": "https://github.com/Maksim-Burtsev/punchcard.git"
      }
    },
    "superpowers-dev": {
      "source": {
        "repo": "obra/superpowers",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "'/Users/mburtsev/.config/agterm/agent-status/agterm-claude-status.sh' blocked",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/open-source/dotfiles/claude/hooks/dotfiles-guard.sh post",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "'/Users/mburtsev/.config/agterm/agent-status/agterm-claude-status.sh' active --blink",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/open-source/dotfiles/claude/hooks/dotfiles-guard.sh stop",
            "statusMessage": "Проверяю дотфайлы...",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "'/Users/mburtsev/.config/agterm/agent-status/agterm-claude-status.sh' completed --auto-reset",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "'/Users/mburtsev/.config/agterm/agent-status/agterm-claude-status.sh' active --blink",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "allow": [
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__search_threads",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__get_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__list_labels",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__create_label",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__label_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__unlabel_thread",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__label_message",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__unlabel_message",
      "mcp__d06ca5cb-f8b2-42b5-bbb3-1eda5aa7a215__update_message_labels",
      "Artifact",
      "PushNotification",
      "Read",
      "Write",
      "Edit",
      "Bash(ls:*)",
      "Bash(date:*)",
      "Bash(cp:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(python3:*)"
    ]
  },
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "tui": "fullscreen"
}
