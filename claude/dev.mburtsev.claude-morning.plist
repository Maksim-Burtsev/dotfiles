<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Claude Code scheduled tasks (mail-triage at 09:00) only fire while the
       desktop app is running. Launch it in the background shortly before,
       so the run does not wait for the first manual open of the day. -->
  <key>Label</key><string>dev.mburtsev.claude-morning</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/open</string><string>-gja</string><string>Claude</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>50</integer></dict>
</dict>
</plist>
